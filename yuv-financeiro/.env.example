# Porta e endereço (atrás do nginx, deixe 127.0.0.1)
PORT=3080
HOST=127.0.0.1
TZ=America/Sao_Paulo
# Pasta do banco SQLite e dos anexos — FAÇA BACKUP DELA
DATA_DIR=./data
# Primeiro administrador (criado só se não houver nenhum usuário)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Cookie só via HTTPS (use 1 em produção com TLS)
COOKIE_SECURE=1
# E-mail: sem SMTP_URL, os e-mails ficam registrados como "simulado"
# Ex.: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
MAIL_FROM=YUV Financeiro <financeiro@yuv.com.br>
# Boleto/NF: hoje só existe o driver "simulado"
BILLING_PROVIDER=simulado
# Segredo do webhook de pagamento (POST /api/webhooks/payment, header x-webhook-secret)
WEBHOOK_SECRET=
# 0 desliga o agendador (relatórios e avisos de teste)
SCHEDULER=1
