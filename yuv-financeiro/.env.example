# Porta e endereço (atrás do nginx, deixe 127.0.0.1)
PORT=3080
HOST=127.0.0.1
TZ=America/Sao_Paulo
# Pasta do banco SQLite, anexos e backups — FAÇA BACKUP DELA FORA DA VPS
DATA_DIR=./data
# Primeiro administrador (criado só se não houver nenhum usuário). Apague a senha depois do 1º acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Endereço público do sistema (usado para cadastrar o webhook na Asaas)
APP_URL=
# Cookie só via HTTPS (deixe 1 em produção)
COOKIE_SECURE=1

# ---------- E-mail ----------
# Sem SMTP_URL os e-mails ficam só registrados como "simulado".
# Ex.: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
MAIL_FROM="YUV Financeiro <financeiro@yuv.com.br>"

# ---------- Boleto e NF ----------
# simulado | asaas
BILLING_PROVIDER=simulado
# sandbox | production  (comece SEMPRE pelo sandbox)
ASAAS_ENV=sandbox
# Chave da API: Asaas > Integrações > Chave de API. Em produção começa com $aact_prod_
ASAAS_API_KEY=
# BOLETO | PIX | UNDEFINED (cliente escolhe boleto ou Pix na fatura)
ASAAS_BILLING_TYPE=BOLETO
# 1 = a Asaas também manda e-mail/SMS ao cliente (o sistema já manda o seu e-mail de cobrança)
ASAAS_NOTIFY=0
# Valores das regras "Multa + juros" e "Desconto pontualidade" do contrato
ASAAS_MULTA_PCT=2
ASAAS_JUROS_PCT_MES=1
ASAAS_DESCONTO_PONTUALIDADE_PCT=5
# NF automática pela Asaas: 0 = desligada (o sistema só marca quais NFs emitir à mão)
NF_AUTOMATICA=0
# NFS-e (só com NF_AUTOMATICA=1) — PREENCHA COM A CONTABILIDADE. Serviço municipal: Asaas > Notas fiscais > configurações
ASAAS_NF_SERVICO_ID=
ASAAS_NF_SERVICO_CODIGO=
ASAAS_NF_SERVICO_NOME=
ASAAS_NF_DESCRICAO=Licença de uso de plataforma de rastreamento e telemetria
# Alíquotas em % (0 se não se aplica ao seu regime tributário)
ASAAS_NF_ISS=0
ASAAS_NF_RETER_ISS=0
ASAAS_NF_PIS=0
ASAAS_NF_COFINS=0
ASAAS_NF_CSLL=0
ASAAS_NF_IR=0
ASAAS_NF_INSS=0
# Token que a Asaas manda no header asaas-access-token (o instalador gera um)
ASAAS_WEBHOOK_TOKEN=

# Webhook genérico (outros provedores): header x-webhook-secret
WEBHOOK_SECRET=
# 0 desliga o agendador (relatórios e avisos de teste)
SCHEDULER=1
