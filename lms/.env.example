# Porta HTTP do LMS (use um proxy reverso nginx com HTTPS na frente)
PORT=3000
# Postgres: pode usar o mesmo servidor do Whaticket, mas com um banco separado
DATABASE_URL=postgres://lms:SENHA_FORTE@localhost:5432/lms
# Gere com: openssl rand -hex 32
SESSION_SECRET=
# true quando estiver atrás de HTTPS (recomendado em produção)
COOKIE_SECURE=true
# URL pública usada em links de mensagens/certificados (também editável em Configurações)
PUBLIC_URL=https://treinamento.suaempresa.com.br
TZ=America/Sao_Paulo
# Tamanho máximo de upload de material (MB)
MAX_UPLOAD_MB=25
# Pasta dos uploads (padrão: ./uploads)
# UPLOAD_DIR=/var/lms/uploads
