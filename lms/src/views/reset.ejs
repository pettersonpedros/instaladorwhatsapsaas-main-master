<%- include('partials/header') %>
<div class="card narrow login">
  <h1>Criar nova senha</h1>
  <% if (!reset) { %>
    <div class="alert error">Este link é inválido, já foi usado ou expirou.</div>
    <p><a class="btn" href="/recuperar-senha">Pedir um novo link</a></p>
  <% } else { %>
    <p class="muted">Conta: <strong><%= reset.email %></strong></p>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/redefinir-senha/<%= token %>">
      <%- include('partials/csrf') %>
      <label>Nova senha <input type="password" name="password" minlength="6" required autofocus autocomplete="new-password"></label>
      <label>Confirmar nova senha <input type="password" name="confirm" minlength="6" required autocomplete="new-password"></label>
      <button class="btn block">Salvar nova senha</button>
    </form>
  <% } %>
</div>
<%- include('partials/footer') %>
