<%- include('partials/header') %>
<div class="card narrow login">
  <h1>Entrar</h1>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <%- include('partials/csrf') %>
    <input type="hidden" name="next" value="<%= next %>">
    <label>E-mail <input type="email" name="email" value="<%= email %>" required autofocus autocomplete="username"></label>
    <label>Senha <input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn block">Entrar</button>
  </form>
  <p class="small"><a href="/recuperar-senha">Esqueci minha senha</a></p>
</div>
<%- include('partials/footer') %>
