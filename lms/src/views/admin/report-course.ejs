<%- include('../partials/header') %>
<% const statusLabel = { concluido: '✅ Concluído', andamento: '▶️ Em andamento', nao_iniciado: '⏸ Não iniciado' }; %>
<p class="muted small"><a href="<%= links.back %>">Relatórios</a> ›</p>
<div class="row-between">
  <h1><%= course.title %></h1>
  <a class="btn secondary" href="?<%= new URLSearchParams({ empresa: companyId || '', status, formato: 'csv' }) %>">⬇ Exportar CSV (Excel)</a>
</div>
<form class="card filters" method="get">
  <select name="empresa"><option value="">Todas as empresas</option><% companies.forEach(c => { %><option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
  <select name="status"><option value="">Todos os status</option><% Object.entries(statusLabel).forEach(([k, v]) => { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= v %></option><% }) %></select>
  <button class="btn secondary">Filtrar</button>
</form>
<%- include('../partials/course-report') %>
<%- include('../partials/footer') %>
